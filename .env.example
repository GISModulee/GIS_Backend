DATABASE_URL=postgresql://postgres:password@localhost:5432/geobackend
MAPSERVER_DATABASE_URL=postgresql://geouser:password@localhost:5432/geodb

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_JSON=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

GEOCLIP_TOP_K=5
MAX_FILE_SIZE_MB=20

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SECRET_KEY=change_this_secret

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

CI_BASE_URL=http://192.168.6.63:8014
MODULE_SLUG=spatial-geographical-analysis

# External Email Dump Backend. GIS calls only
# {EMAIL_DUMP_API_BASE_URL}/api/emails/single/origin-ips/{case_id}.
# Leave empty to disable the integration: the app still starts and the
# Email Dump route reports a configuration error.
EMAIL_DUMP_API_BASE_URL=http://192.168.6.63:8002
EMAIL_DUMP_TIMEOUT_SECONDS=30

# Live data providers
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TIMEOUT_SECONDS=10
AIRCRAFT_CACHE_TTL_SECONDS=10
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?FORMAT=tle
CELESTRAK_TIMEOUT_SECONDS=15
SATELLITE_TLE_CACHE_TTL_SECONDS=3600
SATELLITE_POSITION_CACHE_TTL_SECONDS=5
SATELLITE_MAX_RESULTS=500
